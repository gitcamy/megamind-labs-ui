# Copy to .env.local for `vercel dev`, and add the same names in the Vercel project settings.

# Anthropic key used only by /api/generate. Put it in its own Console workspace with a monthly spend limit.
ANTHROPIC_API_KEY=

# Supabase project (Settings > API). The service role key never leaves the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (use test keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Where the generator page lives
APP_URL=https://megamindlabs.ai/generate.html
APP_ORIGINS=https://megamindlabs.ai,http://localhost:4317

# Stops all generations for the rest of the UTC day once total spend reaches this
DAILY_BUDGET_USD=25

# Optional: pin the kit files the MCP server and generator read, e.g. v0.1.0
KIT_CDN_REF=main
