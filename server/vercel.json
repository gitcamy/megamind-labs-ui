{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/generate.js": { "maxDuration": 300 },
    "api/mcp.js": { "maxDuration": 30 }
  },
  "rewrites": [{ "source": "/mcp", "destination": "/api/mcp" }],
  "headers": [
    { "source": "/hosted.js", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ]
}
